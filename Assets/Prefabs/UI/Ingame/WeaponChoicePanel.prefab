  m_text: "\uC774 \uBB34\uAE30\uB294 \uC790\uB3D9 \uD3EC\uD0D1\uC744 \uC124\uCE58\uD558\uC5EC
    \uC77C\uC815 \uC2DC\uAC04 \uB3D9\uC548 \uC8FC\uBCC0 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4.\r\n\uB808\uBCA8\uC774
    \uC99D\uAC00\uD560\uC218\uB85D \uACF5\uACA9 \uC18D\uB3C4\uC640 \uACF5\uACA9\uB825\uC774
    \uD568\uAED8 \uC99D\uAC00\uD569\uB2C8\uB2E4.\r\n\uB9C8\uC2A4\uD130 \uB808\uBCA8\uC5D0
    \uB3C4\uB2EC\uD558\uBA74 \uCD94\uAC00 \uD6A8\uACFC\uAC00 \uD65C\uC131\uD654\uB418\uC5B4
    \uB354 \uAC15\uB825\uD55C \uC804\uD22C \uC9C0\uC6D0\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
